<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>PostgreSQL persistence, schema management, audit, cleanup, rate limiting, and email outbox support for Ashlar.</Description>
    <PackageTags>ashlar;postgresql;identity;authentication;authorization;email-outbox;security</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashlar\Ashlar.csproj" />
    <ProjectReference Include="..\Ashlar.ProviderContracts\Ashlar.ProviderContracts.csproj" PrivateAssets="compile" />
    <ProjectReference Include="..\Ashlar.Webhooks\Ashlar.Webhooks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="dbup-postgresql" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema\Scripts\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <AshlarTestFriend Include="Ashlar.Postgres.Tests" />
  </ItemGroup>

</Project>
