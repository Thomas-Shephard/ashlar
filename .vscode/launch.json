{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Ashlar.Sample.AspNetCore",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/samples/Ashlar.Sample.AspNetCore/Ashlar.Sample.AspNetCore.csproj",
        "--framework",
        "net10.0",
        "--no-launch-profile"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(http://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      }
    },
    {
      "name": "Launch Ashlar.Sample.AspNetCore",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Ashlar.Sample.AspNetCore",
      "program": "${workspaceFolder}/artifacts/bin/Ashlar.Sample.AspNetCore/debug_net10.0/Ashlar.Sample.AspNetCore.exe",
      "args": [],
      "cwd": "${workspaceFolder}/samples/Ashlar.Sample.AspNetCore",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(http://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      }
    }
  ]
}
