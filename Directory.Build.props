<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable Condition="'$(IsPackable)' == ''">true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <EnablePackageValidation Condition="'$(IsPackable)' == 'true'">true</EnablePackageValidation>

    <!-- Unified Artifacts Output -->
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>

    <!-- Analysis & Code Style -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Tests may use friend access; official package builds must not emit it. -->
    <AshlarOfficialBuild Condition="'$(AshlarOfficialBuild)' == ''">false</AshlarOfficialBuild>

    <!-- Shared NuGet package metadata -->
    <Authors>Thomas Shephard</Authors>
    <Copyright>Copyright (c) $([System.DateTime]::Now.ToString("yyyy")) $(Authors)</Copyright>
    <PackageProjectUrl>https://github.com/Thomas-Shephard/ashlar</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Thomas-Shephard/ashlar.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
</Project>
